# ─── Supabase ───────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ─── Pushmeldingen ───────────────────────────────────────────────────────────────
# Genereer via: npx web-push generate-vapid-keys --json
VITE_WEB_PUSH_VAPID_PUBLIC_KEY=your-vapid-public-key
WEB_PUSH_VAPID_PUBLIC_KEY=your-vapid-public-key
WEB_PUSH_VAPID_PRIVATE_KEY=your-vapid-private-key
WEB_PUSH_SUBJECT=mailto:info@cozy-moments.be
PUSH_AUTOMATION_SECRET=change-me-to-a-random-secret-string

# Optioneel voor de keepalive-script of GitHub Action
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEEPALIVE_PATH=/rest/v1/site_settings?select=id&id=eq.default&limit=1

# ─── Admin authenticatie ──────────────────────────────────────────────────────────
# Optionele bootstrap-fallback als de server-side admincheck tijdelijk niet werkt
VITE_ADMIN_EMAILS=admin@cozy-moments.be

# Alleen voor lokale dev ZONDER Supabase
VITE_ADMIN_PASSWORD=

# ─── QR code beveiliging ─────────────────────────────────────────────────────────
# Genereer via: openssl rand -hex 32
VITE_QR_SECRET=change-me-to-a-random-secret-string
